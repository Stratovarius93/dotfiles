# Lo que necesita la config. install.sh lo instala con `brew bundle`.

# Editor, explorador de archivos y Git TUI
brew "neovim"
brew "ranger"
brew "git"
brew "lazygit"

# Telescope: búsqueda de archivos y de texto
brew "ripgrep"
brew "fd"

# Vista previa de imágenes y código en Telescope y Ranger
brew "chafa"
brew "bat"

# Diffs de lazygit con fondo de color y sintaxis (lazygit/config.yml)
brew "git-delta"

# Flutter por proyecto (flutter-tools usa .fvm si existe)
brew "fvm"

# Para empaquetar el tema Gruvbox Flutter de Antigravity (npx @vscode/vsce)
brew "node"

# Prompt y autocompletado en zsh (estilo Warp)
brew "starship"
brew "fzf"
brew "carapace"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# Para añadir iconos a una fuente propia (Cartograph)
brew "fontforge"

# Fuente gratuita con iconos, por defecto si no tienes Cartograph
cask "font-jetbrains-mono-nerd-font"
