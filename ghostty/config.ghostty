# Gruvbox Flutter — misma fuente y colores que Terminal.app
font-family = CartographCF Nerd Font Mono
font-size = 14

window-width = 148
window-height = 46
window-save-state = never

background = #282828
foreground = #ebdbb2
cursor-color = #fe8019
cursor-text = #282828
selection-background = #504945
selection-foreground = #ebdbb2

# Normal colors (0-7)
palette = 0=#3c3836
palette = 1=#ea6962
palette = 2=#a9b665
palette = 3=#d8a657
palette = 4=#7daea3
palette = 5=#d3869b
palette = 6=#89b482
palette = 7=#d4be98

# Bright colors (8-15)
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ddc7a1
