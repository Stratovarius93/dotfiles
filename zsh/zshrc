# Oh My Zsh + Starship + autocompletado estilo Warp (Gruvbox Flutter)
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""

# Homebrew en PATH antes de cargar plugins (fzf-tab, carapace, starship)
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -x /usr/local/bin/brew ]]; then
  eval "$(/usr/local/bin/brew shellenv)"
fi

plugins=(git fzf-tab)

[[ -f "$ZSH/oh-my-zsh.sh" ]] && source "$ZSH/oh-my-zsh.sh"

export PATH="$HOME/.local/bin:$PATH"

# ── Autocompletado estilo Warp (fzf + fzf-tab + carapace + autosuggestions + syntax) ──
export FZF_DEFAULT_OPTS="\
--height=40% --layout=reverse --border=rounded --margin=0,1 \
--color=bg+:#504945,bg:#282828,spinner:#89b482,hl:#fe8019 \
--color=fg:#ebdbb2,header:#928374,info:#d8a657,pointer:#fe8019 \
--color=marker:#a9b665,fg+:#f2e7ca,prompt:#fe8019,hl+:#fabd2f \
--color=border:#504945"

# fzf keybindings (Ctrl+R historial interactivo, Ctrl+T archivos, Alt+C carpetas)
command -v fzf >/dev/null && source <(fzf --zsh)

# fzf-tab: menú desplegable interactivo al pulsar Tab
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' menu no
zstyle ':fzf-tab:*' fzf-flags --color=bg+:#504945,bg:#282828,hl:#fe8019,fg:#ebdbb2,info:#d8a657,pointer:#fe8019,fg+:#f2e7ca,prompt:#fe8019,hl+:#fabd2f,border:#504945
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'ls -la --color=always $realpath 2>/dev/null || ls -la $realpath'
zstyle ':fzf-tab:*' switch-group '<' '>'

# carapace: completado con descripciones de subcomandos y flags
if command -v carapace >/dev/null; then
  export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
  source <(carapace _carapace zsh)
fi

# zsh-autosuggestions: sugerencias en línea (acepta con →)
ZSH_AUTOSUGGEST_STRATEGY=(history completion)
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=#928374'
[[ -n "$HOMEBREW_PREFIX" && -f "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && \
  source "$HOMEBREW_PREFIX/share/zsh-autosuggestions/zsh-autosuggestions.zsh"

# zsh-syntax-highlighting: resaltado de sintaxis en tiempo real (siempre al final)
[[ -n "$HOMEBREW_PREFIX" && -f "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && \
  source "$HOMEBREW_PREFIX/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# Prompt Starship
command -v starship >/dev/null && eval "$(starship init zsh)"

# Config local opcional por máquina (no versionada)
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
