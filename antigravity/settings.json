{
  // WORKBENCH
  "workbench.sideBar.location": "right",
  // FLUTTER DART
  "dart.lineLength": 80,
  "dart.flutterSdkPath": ".fvm/flutter_sdk",
  // No analizar carpetas sin código Dart propio (build/ puede pesar GB y retrasa el coloreado semántico)
  "dart.analysisExcludedFolders": ["build", "ios", "android", "macos", "linux", "windows", "web"],
  "dart.previewFlutterUiGuides": true,
  "dart.previewFlutterUiGuidesCustomTracking": true,
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.selectionHighlight": false,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off",
    "editor.defaultFormatter": "Dart-Code.dart-code",
    "editor.autoIndent": "full",
    "editor.fontLigatures": true,
  },
  "vim.leader": "<space>",
  "vim.easymotion": true,
  "vim.statusBarColorControl": true,
  "vim.statusBarColors.easymotionmode": "#F5946E",
  "vim.statusBarColors.easymotioninputmode": "#F5946E",
  "vim.statusBarColors.normal": [
    "#8FBCBB",
    "#434C5E"
  ],
  "vim.statusBarColors.insert": "#BF616A",
  "vim.statusBarColors.visual": "#B48EAD",
  "vim.statusBarColors.visualline": "#B48EAD",
  "vim.statusBarColors.visualblock": "#A3BE8C",
  "vim.statusBarColors.replace": "#D08770",
  "vim.statusBarColors.commandlineinprogress": "#007ACC",
  "vim.statusBarColors.searchinprogressmode": "#C6D6A7",
  "vim.statusBarColors.surroundinputmode": "#007ACC",
  "vim.incsearch": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.hlsearch": true,
  "vim.normalModeKeyBindings": [
    {
      "before": [
        "<tab>"
      ],
      "commands": [
        "workbench.action.nextEditorInGroup"
      ]
    },
    {
      "before": [
        "<leader>",
        "d"
      ],
      "commands": [
        "workbench.action.debug.start"
      ]
    },
    {
      "before": [
        "<leader>",
        "a"
      ],
      "commands": [
        "editor.action.quickFix"
      ]
    },
    {
      "before": [
        "<leader>",
        "r"
      ],
      "commands": [
        "flutter.hotReload"
      ]
    },
    {
      "before": [
        "<leader>",
        "R"
      ],
      "commands": [
        "flutter.hotRestart"
      ]
    },
    {
      "before": [
        "<leader>",
        "f"
      ],
      "commands": [
        "workbench.action.quickOpen"
      ]
    },
    {
      "before": [
        "<leader>",
        "F"
      ],
      "commands": [
        "fzf-quick-open.runFzfFile"
      ]
    },
    {
      "before": [
        "`"
      ],
      "commands": [
        "workbench.action.previousEditorInGroup"
      ]
    },
    {
      "before": [
        "w"
      ],
      "commands": [
        "workbench.action.files.save"
      ]
    },
    {
      "before": [
        "W"
      ],
      "commands": [
        "workbench.action.files.saveFiles"
      ]
    },
    {
      "before": [
        "q"
      ],
      "commands": [
        "workbench.action.closeActiveEditor"
      ]
    },
    {
      "before": [
        "<leader>",
        "n"
      ],
      "commands": [
        "workbench.action.toggleSidebarVisibility"
      ]
    },
    {
      "before": [
        "<leader>",
        "c"
      ],
      "commands": [
        "workbench.action.chat.toggle"
      ]
    },
    {
      "before": [
        "<leader>",
        "m"
      ],
      "commands": [
        "antigravity.openAgent"
      ]
    },
    {
      "before": [
        "<leader>",
        "/"
      ],
      "commands": [
        "workbench.action.showCommands"
      ]
    },
    {
      "before": [
        "<leader>",
        "N"
      ],
      "commands": [
        "workbench.action.toggleActivityBarVisibility"
      ]
    },
    {
      "before": [
        "<leader>",
        "e"
      ],
      "commands": [
        "workbench.action.focusActivityBar"
      ]
    },
    {
      "before": [
        "<leader>",
        "g",
        "d"
      ],
      "commands": [
        "editor.action.revealDefinitionAside"
      ]
    },
    {
      "before": [
        "<leader>",
        "x"
      ],
      "commands": [
        "editor.action.showDefinitionPreviewHover"
      ]
    },
    {
      "before": [
        "<leader>",
        "S"
      ],
      "commands": [
        "editor.action.startFindReplaceAction"
      ]
    },
    {
      "before": [
        "<leader>",
        "i"
      ],
      "commands": [
        "editor.action.referenceSearch.trigger"
      ]
    }
  ],
  "vim.insertModeKeyBindings": [
    {
      "before": [
        "j",
        "k"
      ],
      "after": [
        "<Esc>"
      ]
    },
    {
      "before": [
        "k",
        "j"
      ],
      "after": [
        "<Esc>"
      ]
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "ctrl+d"
      ],
      "after": [
        "ctrl+d",
        "M"
      ]
    },
    {
      "before": [
        "ctrl+u"
      ],
      "after": [
        "ctrl+u",
        "M"
      ]
    },
    {
      "before": [
        "<C-n>"
      ],
      "commands": [
        ":nohl"
      ]
    },
    {
      "before": [
        ","
      ],
      "after": [
        "A",
        ",",
        "<Esc>"
      ]
    },
    {
      "before": [
        ";"
      ],
      "after": [
        "A",
        ";",
        "<Esc>"
      ]
    },
    {
      "before": [
        "<leader>",
        "c",
        "i"
      ],
      "commands": [
        "editor.action.commentLine"
      ]
    },
    {
      "before": [
        "<leader>",
        "6"
      ],
      "after": [
        "^",
        "v",
        "%"
      ]
    },
    {
      "before": [
        "<leader>",
        "^"
      ],
      "after": [
        "b",
        "v",
        "%"
      ]
    },
    {
      "before": [
        "<leader>",
        "s"
      ],
      "after": [
        "leader",
        "leader",
        "s"
      ]
    }
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<leader>",
        "c",
        "i"
      ],
      "commands": [
        "editor.action.commentLine"
      ],
      "when": "editorTextFocus && !editorReadonly"
    },
    {
      "before": [
        "<leader>",
        "S"
      ],
      "commands": [
        "editor.action.startFindReplaceAction"
      ]
    },
    {
      "before": [
        "u"
      ],
      "commands": [
        "undo"
      ]
    },
    {
      "before": [
        "c-r"
      ],
      "commands": [
        "redo"
      ]
    }
  ],
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false
  },
  "editor.fontFamily": "Cartograph CF",
  "editor.fontSize": 13.5,
  "workbench.colorTheme": "Gruvbox Flutter Theme",
  "window.density.editorTabHeight": "compact",
  "editor.minimap.enabled": false,
  "breadcrumbs.enabled": false,
  "workbench.iconTheme": "gruvbox-flutter-icons",
  "gitlens.graph.details.location": "auto",
  "claudeCode.preferredLocation": "panel",
  "gitlens.graph.changesColumn.enabled": true,
  "claudeCode.hideOnboarding": true,
  "workbench.colorCustomizations": {
    "statusBar.background": "#8FBCBB",
    "statusBar.noFolderBackground": "#8FBCBB",
    "statusBar.debuggingBackground": "#8FBCBB",
    "statusBar.foreground": "#434C5E",
    "statusBar.debuggingForeground": "#434C5E"
  }
}